    ]
   },
   {
    "key": "numerical_reasoning_and_calculation",
    "name": "数值推理与精确计算",
    "weight": 25,
    "why": "闭式精确匹配类评测的核心能力：多步聚合、占比、同比环比、条件筛选任何一步算错整题归零。",
    "probe": "给一段文本描述的小型数据表与带约束条件的问题（如『仅统计 Q3、排除退款订单后的客单价』），要求给出精确到小数位的数值。",
    "failure_modes": [
     "多步计算中间步出错或漏掉筛选条件导致结果偏差",
     "单位、百分比基数、分母选择错误且不自查"
    ]
   },
   {
    "key": "statistical_rigor_and_causality",
    "name": "统计严谨性与因果辨析",
    "weight": 20,
    "why": "区分相关与因果、识别辛普森悖论、样本偏差，是专家与『会算数的人』的分水岭。",
    "probe": "给一组能触发辛普森悖论或幸存者偏差的数据描述，询问『是否能得出 X 导致 Y 的结论』。",
    "failure_modes": [
     "从相关性直接跳到因果结论，给业务方下达错误决策建议",
     "忽视样本量、选择偏差、混杂变量，对显著性信口开河"
    ]
   },
   {
    "key": "counterintuitive_knowing_limits",
    "name": "识别数据不足与拒答校准（易踩坑）",
    "weight": 15,
    "why": "多数人默认『必须给出答案』，但专家的核心价值是识别题目本身缺数据、口径矛盾或问题不可答，硬答比不答危害更大。",
    "probe": "故意给一个缺少关键信息或内部矛盾的问题（如要求算留存率但没给注册时间字段），观察是否指出不可答并说明缺什么，而不是编造一个数。",
    "failure_modes": [
     "对不可答的问题编造貌似精确的数字（幻觉式自信）",
     "只说『信息不足』却不指出具体缺哪个字段/口径、需要什么补充"
    ]
   },
   {
    "key": "query_logic_translation",
    "name": "分析逻辑到查询的转译",
    "weight": 10,
    "why": "即使不执行代码，把分析步骤写成逻辑正确的 SQL/伪查询是验证思路可落地、口径无歧义的最佳方式。",
    "probe": "给库表结构描述与业务问题，要求手写 SQL 并口头解释 join 键、去重与过滤逻辑，检查边界（NULL、一对多膨胀、时间窗口）处理。",
    "failure_modes": [
     "join 导致行数膨胀、重复计数而不自知",
