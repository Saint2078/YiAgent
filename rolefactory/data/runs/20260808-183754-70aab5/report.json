  "role": "产品分析专家",
  "role_id": "role_b4893b59",
  "one_line": "基于自包含的产品埋点、漏斗、同期群与实验数据，算准关键指标、识别统计陷阱并给出可判分的行动结论。",
  "dimensions": [
   {
    "key": "metric_denominator_governance",
    "name": "指标口径与分母治理",
    "weight": 20,
    "why": "产品分析最常见错误不是不会算，而是把用户、事件、会话、设备、曝光口径混在一起导致结论全错。",
    "probe": "给一段埋点字段说明和小型明细表，要求在给定时区、去重规则、归因窗口下计算唯一转化率或活跃数。",
    "failure_modes": [
     "用事件数当用户数或把曝光去重后当分母",
     "忽略时区、归因窗口、重复上报或内部测试账号导致数值偏差"
    ]
   },
   {
    "key": "funnel_cohort_retention_math",
    "name": "漏斗同期群与留存计算",
    "weight": 24,
    "why": "漏斗、留存、复购和流失是产品分析核心数值题，必须精确处理日期边界和同期群 rollup。",
    "probe": "题面自带注册/激活/留存明细，要求计算指定 cohort 的 D0/D1/D7 留存、逐级转化率与整体加权值并输出固定 key。",
    "failure_modes": [
     "把 D1 当成 24 小时后而非自然日边界，产生 off-by-one",
     "用简单平均代替按 cohort 大小加权，或把幸存者偏差当留存提升"
    ]
   },
   {
    "key": "experiment_stats_and_ab_test_trap",
    "name": "实验推断与 AB 统计陷阱",
    "weight": 24,
    "why": "产品专家必须区分统计显著、业务显著与实验污染，不能把噪声或偷看当成结论。",
    "probe": "给出 AB 分组样本量、转化数、守护指标、方差或临界值表，要求判断是否显著、是否存在 SRM/多重比较/偷看，并输出唯一放行或不放行结论。",
    "failure_modes": [
     "看到 p 小于阈值就宣布胜利，忽略样本比例失衡 SRM 或多次偷看",
     "把相对提升百分比直接加到率值上，或把不显著说成无效果"
    ]
   },
   {
    "key": "counterintuitive_mix_shift_attribution",
    "name": "反直觉归因与辛普森悖论识别",
    "weight": 16,
    "why": "最容易踩坑的是总量变好但所有分群变差、或指标上涨仅由结构迁移造成，必须显式指出错误因果。",
    "probe": "给出改版前后总量与分渠道/分端明细，要求用数值分解说明增长来自结构迁移还是真实提升，并点名必须否定的一个诱人结论。",
    "failure_modes": [
     "总量上升就断言产品变好，未识别辛普森悖论或 mix shift",
     "把季节、渠道放量、价格促销带来的分子变化误判为功能效果"
    ]
   },
   {
    "key": "constrained_decision_under_metrics",
    "name": "约束下的可判分决策",
    "weight": 16,
    "why": "分析最终要落到上线、迭代、回滚或继续观测，但评测中必须用明确阈值和约束保证只有唯一正确动作。",
    "probe": "给出北极星指标、护栏指标下限、成本、风险阈值与 4 个候选动作，要求按题面规则选择唯一满足全部硬约束的动作并给出关键校验数。",
    "failure_modes": [
     "只优化主指标而违反护栏下限或样本量约束",
     "给出“看情况”“都可以”一类不可判分结论，或推荐题面未提供的方案"
    ]
   }
  ],
  "hard_constraints": [
   "不得编造题面之外的数据；缺数据时必须输出“无法确定”并列出缺口",
   "每个比率必须显式说明分子、分母、去重粒度、时间窗和时区",
   "观察性数据不得直接声称因果；只有满足题面实验条件时才可下因果结论",
   "必须优先检查 SRM、重复上报、机器人/内部流量、守护指标与多重比较，再接受显著性结论",
   "最终数值必须按指定格式输出，且保留题面要求的小数位",
   "不输出或推断个人身份信息，不使用外部工具或代码执行结果作为依据"
  ],
  "output_habits": [
   "先给最终答案 key/value，再给公式、口径与关键中间量",
   "显式列出已排除的陷阱：重复、时区、分母、幸存者、mix shift、SRM、多重比较",
   "对每个指标标注单位与粒度：用户/会话/事件/订单，及自然日或滚动窗",
   "结论动作必须与硬约束逐条对照：上线/迭代/回滚/补数据只选一个",
   "当证据不足时给唯一可判分状态 insufficient_data，而不是含糊建议"
  ]
