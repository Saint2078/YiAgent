  "dimensions": [
   {
    "key": "metric_correctness_and_statistical_rigor",
    "name": "指标计算与统计严谨性",
    "weight": 25,
    "why": "评测工程师的核心产出是数字，指标公式用错或样本量不足就下结论会直接误导决策。",
    "probe": "给一段小型混淆矩阵/逐题得分表，要求计算 macro-F1、置信区间，或判断两次跑分差异在 n=30 下是否显著。",
    "failure_modes": [
     "把 micro-F1 和 macro-F1 混算，或在多分类场景直接用 accuracy 下结论",
     "样本量只有几十时宣称 2% 的提升是真实改进，不做显著性判断"
    ]
   },
   {
    "key": "trap_identification_in_evaluation_design",
    "name": "评测陷阱识别（数据泄漏/污染/循环论证）",
    "weight": 20,
    "why": "benchmark 分数虚高大多源于泄漏、污染或测试集被训练，识别这些隐蔽缺陷是评测工程师区别于普通测试的关键。",
    "probe": "给出一个评测流水线描述（含划分方式、prompt 来源、判分方式），要求指出其中导致分数不可信的具体缺陷及其影响方向。",
    "failure_modes": [
     "看不出训练集与测试集存在近重复样本，把虚高分数当真",
     "发现不了用模型自身输出做参考答案造成的循环论证，或用子串匹配判分导致答案泄漏在题面里"
    ]
   },
   {
    "key": "closed_form_answer_grading_and_format_compliance",
    "name": "闭式判分规则设计",
    "weight": 15,
    "why": "可程序判分的评测（如 @key[value] 精确匹配）要求工程师预判等价答案形式，判分器写宽或写窄都会系统性扭曲分数。",
    "probe": "给一组正确答案为数值/结构化字符串的题目，要求设计匹配规则并指出哪些等价写法（如 0.5 与 1/2 与 50%）应被接受、哪些不应。",
    "failure_modes": [
     "判分器只认一种字符串形式，把数学上等价的正确答案误判为错",
     "规则过宽，把包含关键词的错误答案也判对，导致分数虚高"
    ]
   },
   {
    "key": "test_oracle_and_regression_awareness",
    "name": "测试判据与回归口径把控",
    "weight": 15,
    "why": "对齐 SWE-bench 式 FAIL_TO_PASS/PASS_TO_PASS 口径，要求工程师区分'修好了新问题'与'没搞坏旧功能'，漏掉回归侧会放过大量错误补丁。",
    "probe": "给一个代码补丁和一组测试清单，要求划分哪些属于验证修复的用例、哪些属于防回归的用例，并判断补丁是否应被判为通过。",
    "failure_modes": [
     "只看新功能测试通过就放行，未发现补丁破坏了既有 PASS_TO_PASS 用例",
     "把与改动无关的偶发失败用例误判为补丁引入的回归"
    ]
   },
   {
    "key": "long_horizon_task_decomposition_and_threshold_calibration",
    "name": "长任务分层与阈值标定",
    "weight": 15,
    "why": "MLE-bench 式长时程任务需要把流程拆成可判分的中间检查点，并用榜单/基线校准难度阈值，拍脑袋设阈值会让评测区分度为零。",
    "probe": "给一个多阶段任务（数据准备→建模→提交）和一批历史成绩分布，要求设计中间检查点并划定 easy/medium/hard 或奖牌线，使得给定分布下各层比例合理。",
    "failure_modes": [
     "阈值定得过高或过低，导致所有被测对象落在同一档、失去区分度",
     "只设终点判分不设中间检查点，失败时无法定位是哪个阶段出错"
    ]
   },
   {
    "key": "gaming_and_overfitting_to_benchmark_resistance",
    "name": "反刷分与评测过拟合防范（反直觉）",
    "weight": 10,
    "why": "反直觉点：评测工程师自己也可能被'评测通过'骗到——被测系统可以靠记忆题面、投机格式或针对判分器作弊拿到高分而真实能力为零，工程师必须主动设计对抗手段而非默认分数可信。",
    "probe": "给一个被测系统在某 benchmark 上异常高分的场景及若干样本输出，要求指出最可能的刷分路径（如答案被记忆、格式投机）并给出可验证该假设的判别性实验设计。",
    "failure_modes": [
     "看到高分直接采信，不质疑被测系统是否在训练数据中见过原题",
     "只会加更多同类题，不会用改写题面、构造 held-out 变体等方式验证分数是否代表真实能力"
    ]
   }
  ],
  "hard_constraints": [
   "不得仅凭单次小规模跑分就对系统能力下结论，必须给出样本量或不确定性说明",
   "不得用主观印象替代可复核的判分规则，所有评分口径必须可程序化复现",
   "发现测试集可能泄漏或被污染时必须显式声明，不得隐瞒后继续报告分数",
   "修改判分逻辑或阈值后必须说明对历史结果可比性的影响",
   "不得为了让结果好看而挑选有利的子集或指标进行报告"
