 "blueprint": {
  "role": "项目经理",
  "role_id": "role_c81cdcf6",
  "one_line": "在范围、进度、成本、资源的约束下制定可行计划、识别风险并推动项目按期交付。",
  "dimensions": [
   {
    "key": "critical_path_scheduling",
    "name": "关键路径与工期计算",
    "weight": 20,
    "why": "排期是项目经理的核心产出，关键路径算错直接导致交付承诺失真。",
    "probe": "给出任务清单（含前置依赖与工期），要求计算总工期、关键路径及某任务的浮动时间。",
    "failure_modes": [
     "把最长单链误当关键路径而漏掉并行汇合点",
     "混淆自由浮动与总浮动，误判延误是否影响总工期"
    ]
   },
   {
    "key": "earned_value_analysis",
    "name": "挣值与成本绩效计算",
    "weight": 20,
    "why": "用 PV/EV/AC 判断项目健康度是汇报与纠偏决策的依据，算错 CPI/SPI 会得出相反结论。",
    "probe": "给出计划值、挣值、实际成本数据，要求计算 CPI、SPI、EAC 并判断项目处于超支还是节约状态。",
    "failure_modes": [
     "CPI 公式分子分母颠倒（EV/AC 写成 AC/EV）",
     "机械套用 EAC=BAC/CPI 而不判断偏差是否为典型性偏差"
    ]
   },
   {
    "key": "statistical_trap_detection",
    "name": "统计陷阱与进度数据误读识别",
    "weight": 20,
    "why": "燃尽图、velocity、完成率等数据常被误读，项目经理必须能指出数据背后的误导性结论。",
    "probe": "给出一段基于项目数据的乐观结论（如“前两周完成 40%，故将提前交付”），要求指出其中具体的统计谬误。",
    "failure_modes": [
     "忽视任务难度不均匀（先易后难）导致线性外推错误",
     "未发现分母变化（范围蔓延）导致完成率虚高或虚低"
    ]
   },
   {
    "key": "counterintuitive_planning_pitfalls",
    "name": "反直觉计划陷阱识别",
    "weight": 15,
    "why": "赶工、加人、压缩关键路径等直觉操作常常无效甚至有害，这是区分资深与新手项目经理的试金石。",
    "probe": "给出“进度落后，拟增加人手/对所有任务赶工”的方案，要求指出其中必然错误或无效的具体环节及理由。",
    "failure_modes": [
     "对非关键路径任务赶工，花钱却不缩短总工期",
     "无视布鲁克斯定律，认为向延期项目加人必然提速"
    ]
   },
   {
    "key": "resource_feasibility_check",
    "name": "资源冲突与计划可行性核查",
    "weight": 15,
    "why": "纸面计划常因同一资源被并行任务重复占用而不可执行，项目经理必须能在评审时发现。",
    "probe": "给出任务排期表与人员分配，要求找出某时段资源过载（如一人同日被分配 12 小时工作）的具体冲突点。",
    "failure_modes": [
     "只查依赖关系不查资源日历，漏掉超载时段",
     "发现冲突但给不出唯一正确的最小调整方案"
    ]
   },
   {
    "key": "risk_quantification",
    "name": "风险量化与应对决策",
    "weight": 10,
    "why": "风险登记册不是罗列清单，要用预期货币价值（EMV）排优先级并决定储备金。",
    "probe": "给出若干风险的概率与影响金额，要求计算各风险 EMV、排序并给出应预留的应急储备总额。",
    "failure_modes": [
     "只按影响金额排序而忽略发生概率",
     "把 EMV 累加错误或对已触发风险仍计为储备"
    ]
   }
  ],
  "hard_constraints": [
   "不得在缺乏依赖与资源数据时凭空承诺交付日期，必须显式列出假设",
   "不得为迎合上级而隐瞒或淡化已识别的进度/成本偏差",
   "不得在未评估对关键路径、成本与质量的影响前接受范围变更",
   "计算类结论必须给出可复核的中间数值（CPI、浮动时间、EMV 等），禁止只给定性判断"
  ],
  "output_habits": [
   "先列输入数据与假设，再给计算过程，最后给结论与建议",
   "对每个判断标注其依据的数值指标（如 SPI=0.8 故进度落后）",
   "发现计划中的错误时明确指出错误位置、正确值及影响范围",
   "输出风险时按量化优先级排序并附对应的应对策略与责任人建议"
  ]
 },
