 "blueprint": {
  "role": "软件开发工程师",
  "role_id": "role_cbf11840",
  "one_line": "在需求约束下设计、实现并验证可正确运行且可维护的软件系统。",
  "dimensions": [
   {
    "key": "code_defect_localization",
    "name": "代码缺陷定位与修复推断",
    "weight": 25,
    "why": "工程师日常最大产出就是改对 bug，改错行号或修错根因直接导致回归。",
    "probe": "给出一段 30-80 行带唯一确定性 bug 的代码及其失败现象，要求指出出错行号并给出修复后的正确输出值。",
    "failure_modes": [
     "只描述症状不定位根因，指错代码行",
     "修复引入新错误，导致原本通过的路径被破坏（PASS_TO_PASS 失败）"
    ]
   },
   {
    "key": "boundary_numeric_traps",
    "name": "边界条件与数值陷阱识别",
    "weight": 20,
    "why": "溢出、浮点、闰年、时区是生产事故高发区，且多数人会凭直觉答错。",
    "probe": "要求计算 32 位有符号整数下某表达式的结果、IEEE754 浮点累加后的精确行为，或跨时区/闰秒场景下的时间差数值。",
    "failure_modes": [
     "默认整数无限精度、浮点精确相等，给出数学上正确但机器上错误的值",
     "忽略闰年规则细节（如 1900 非闰年）或时区偏移方向算反"
    ]
   },
   {
    "key": "complexity_capacity_estimation",
    "name": "复杂度与容量数值估算",
    "weight": 15,
    "why": "选型与扩容决策依赖数量级判断，算错一个数量级就是架构事故。",
    "probe": "给定数据规模与硬件参数，计算算法时间复杂度下的大致耗时、存储占用字节数或 QPS 阈值等唯一数值。",
    "failure_modes": [
     "混淆 O(n log n) 与 O(n²) 的渐进差异导致数量级错误",
     "单位换算出错（bit/byte、KB/KiB、毫秒/秒）"
    ]
   },
   {
    "key": "test_reasoning_oracle",
    "name": "测试推断与预期输出推导",
    "weight": 15,
    "why": "能否在脑内执行代码并推导断言值，决定其写出的单测是否真的构成有效验证。",
    "probe": "给出函数实现，要求推导特定输入的精确返回值、或判断给定断言中哪一条会失败并给出实际值。",
    "failure_modes": [
     "推导输出时漏掉隐式类型转换或字符串格式细节（空格、换行、大小写）",
     "把'能跑通'当成'正确'，无法指出断言本身的错误预期"
    ]
   },
   {
    "key": "data_statistical_reasoning",
    "name": "数据统计推理与聚合陷阱",
    "weight": 15,
    "why": "工程师常从日志和指标表得结论，统计误读会直接驱动错误的技术决策。",
    "probe": "给定一张小型数据表（题面内嵌），在显式约束下计算聚合值，或识别'对平均值再求平均'、辛普森悖论、幸存者偏差类陷阱并给出正确数值。",
    "failure_modes": [
     "对分组均值做未加权再平均，得到错误的总体均值",
     "无视题面方法约束（如必须过滤某类行）而给出通用但违规的算法"
    ]
   },
   {
    "key": "counterintuitive_concurrency_semantics",
    "name": "反直觉语义与并发行为判断",
    "weight": 10,
    "why": "缓存、并发、语言语义中的反直觉行为是面试与事故复盘中最易集体答错的盲区。",
    "probe": "询问如'加锁后为何仍需双重检查''HTTP 幂等与重试为何仍会产生重复扣款'等问题，要求指出唯一正确的根因并给出确定性结论。",
    "failure_modes": [
     "凭直觉断言'加锁就线程安全''重试必然安全'，忽视可见性与非原子性",
     "把相关当因果，将时序巧合误认为根因"
    ]
   }
  ],
  "hard_constraints": [
   "不得在需求/题面约束之外擅自改变接口签名、输入输出格式或数据口径",
   "涉及数值答案必须给出精确值，禁止以'大约''应该没问题'代替可验证结果",
   "修复缺陷时不得破坏既有通过路径（不得为修一个 bug 引入回归）",
   "无法确定根因时必须显式说明不确定性，禁止编造看似合理的解释"
  ],
  "output_habits": [
   "先给结论性数值或定位行号，再给推导过程，便于自动判分",
   "推导过程中显式标注单位、进制、时区等易错前提",
   "主动列出验证过的边界用例（空输入、极值、溢出点）",
   "指出陷阱题时明确说出'直觉答案 X 为何错误，正确值 Y'"
  ]
 },
